# Copia este archivo a .env, descomenta y completa los valores. NUNCA commitees .env.
# Los valores por defecto del código son SOLO para desarrollo local.
# Deja comentada (no vacía) una variable que no uses: "VAR=" vacía anula el default.
#
# ┌─ PRODUCCIÓN: requisitos obligatorios ─────────────────────────────────────┐
# │ 1. JWT_SECRET definido, con al menos 32 bytes aleatorios.                 │
# │    Sin él (o si es más corto) la API NO ARRANCA.                          │
# │ 2. AUTH_DEV_MODE APAGADO: ausente o distinto de "true".                   │
# │    Con "true" se exponen códigos OTP y se permite una clave de firma      │
# │    pública. Nunca en producción.                                          │
# │ 3. SMTP_USER / SMTP_PASS configurados, o el login por email responde 503. │
# │ 4. SERVICE_API_KEY para los endpoints de máquina (sin ella se rechazan).  │
# │ 5. DATABASE_URL hacia un disco persistente, o la API NO ARRANCA.          │
# └───────────────────────────────────────────────────────────────────────────┘
#
# DESARROLLO LOCAL rápido: basta con AUTH_DEV_MODE=true (sin JWT_SECRET ni SMTP).

# Orígenes permitidos por CORS en api/main.py, separados por comas.
# Por defecto (dev): http://127.0.0.1:8000,http://localhost:5173
# CORS_ALLOWED_ORIGINS=

# ── Correo saliente (core/notifications.py) ──────────────────────────────────
# Cuenta SMTP que envía los códigos de verificación y los recibos de compra. Sin ella,
# fuera del modo desarrollo /auth/email/start responde 503 y no emite ningún código
# usable, y los recibos no se envían (la compra no se ve afectada).
# SMTP_USER=
# SMTP_PASS=
# Servidor con TLS implícito y timeout de cada envío (los valores son los defaults).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_TIMEOUT_SECONDS=10

# SOLO DESARROLLO LOCAL — en producción debe estar APAGADO (ausente o != "true").
# Con AUTH_DEV_MODE=true (exactamente "true", sin distinguir mayúsculas):
#   - /auth/email/start incluye el código en "code_demo" y funciona sin SMTP;
#   - si JWT_SECRET no está definido, los tokens se firman con una clave de
#     DESARROLLO que está en el repositorio (cualquiera podría falsificarlos).
# Con cualquier otro valor, o sin la variable, el código NUNCA se devuelve (ni si
# falla el envío) y la clave de desarrollo es inutilizable.
# AUTH_DEV_MODE=true

# Política del código OTP (enteros positivos; los valores indicados son los defaults).
# AUTH_OTP_TTL_SECONDS=600               # validez del código (10 min)
# AUTH_OTP_MAX_ATTEMPTS=5                # intentos fallidos antes de invalidarlo
# AUTH_OTP_RESEND_COOLDOWN_SECONDS=60    # espera mínima entre pedidos al mismo email
# AUTH_OTP_MAX_SENDS_PER_HOUR=5          # pedidos máximos por email en una hora

# ── Access tokens (JWT HS256, core/auth_tokens.py) ───────────────────────────
# Clave con la que se firman y validan los tokens que emite /auth/email/check.
# OBLIGATORIA en producción. La API valida esta configuración AL ARRANCAR y se
# niega a iniciar si:
#   - JWT_SECRET no está definido y AUTH_DEV_MODE no es "true", o
#   - JWT_SECRET tiene menos de 32 bytes (incluso con AUTH_DEV_MODE=true).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Guárdala en tu gestor de secretos; no la reutilices entre entornos.
# JWT_SECRET=

# Vida del access token en segundos (entero positivo). Default: 3600 (60 min).
# JWT_TTL_SECONDS=3600

# ── Roles: admin y service (api/security.py) ─────────────────────────────────
# Tres identidades:
#   user     humano verificado por OTP de email (rol por defecto).
#   admin    humano cuyo email está en ADMIN_EMAILS: /auth/email/check le emite
#            un JWT con role="admin". Ve TODO el historial (GET /audit) y todas las
#            disputas (GET /disputes); un usuario ve solo lo suyo.
#   service  máquina: NO usa OTP ni JWT; envía el header "X-Service-Key: <key>".
#
# Emails admin, separados por comas (sin distinguir mayúsculas). Quitar un email
# de la lista le retira el acceso admin de inmediato, aunque tenga un token vigente.
# Vacío o ausente = no hay admins.
# ADMIN_EMAILS=ops@example.com,security@example.com

# API key(s) de servicio, separadas por comas (varias permiten rotarlas sin cortar
# el servicio). Se comparan en tiempo constante.
#   - Ausente o vacía: la API arranca igual y los endpoints de servicio
#     (p. ej. POST /verify) rechazan TODO con 401 (fail-closed).
#   - Configurada: CADA key debe tener al menos 16 bytes; si alguna es más corta,
#     la API NO ARRANCA (configuración inválida, el error indica cuál key).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# (43 caracteres). Guárdala en tu gestor de secretos; una distinta por entorno.
# SERVICE_API_KEY=

# ── IA: búsqueda de ofertas y firewall semántico (core/llm.py) ───────────────
# Un solo cliente para todo el backend (docs/design/responsible-ai.md).
# Sin OPENAI_API_KEY: la búsqueda real no devuelve ofertas (no se inventan) y el
# firewall usa su heurística determinista. Con la clave, cada corrida del agente
# GASTA en tu cuenta de OpenAI: configura allí también un límite de gasto (P-16).
# OPENAI_API_KEY=
# Modelo (default gpt-6-luna, verificado el 16 nov 2026 en la doc oficial).
# OPENAI_MODEL=gpt-6-luna
# LLM_TIMEOUT_SECONDS=20         # timeout por request (entero positivo)
# LLM_MAX_RETRIES=1              # reintentos del SDK (entero >= 0)
# LLM_MAX_OUTPUT_TOKENS=2000     # presupuesto de salida por request; una respuesta
#                                # cortada por el tope se descarta (fail-closed)

# ── Cuota de corridas del agente por usuario (core/quotas.py, P-16) ──────────
# AGENT_RUN_QUOTA_PER_USER=20             # corridas por ventana
# AGENT_RUN_QUOTA_WINDOW_SECONDS=86400    # ventana (24 h)

# ── Base de datos (core/db.py, P-10) ─────────────────────────────────────────
# SQLite con migraciones de Alembic; la API migra sola al arrancar.
# OBLIGATORIA fuera de desarrollo: sin ella la API no arranca (evita escribir en un
# archivo efímero del contenedor creyendo que persiste). En producción, un archivo
# en un DISCO PERSISTENTE (cuatro barras = ruta absoluta):
# DATABASE_URL=sqlite:////data/agentbuyer.db
# Con AUTH_DEV_MODE=true y sin DATABASE_URL se usa var/agentbuyer.db (en .gitignore).
# "Empezar de cero" en desarrollo = borrar ese archivo con la API detenida.

# ── Logging (core/logging_config.py) ─────────────────────────────────────────
# Nivel del log (DEBUG, INFO, WARNING, ERROR). Cada línea lleva el request id de su
# petición (cabecera X-Request-ID). Nunca se registran emails completos, códigos OTP,
# tokens ni firmas.
# LOG_LEVEL=INFO
