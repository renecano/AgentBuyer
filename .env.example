# Copia este archivo a .env, descomenta y completa los valores. NUNCA commitees .env.
# Los valores por defecto del código son SOLO para desarrollo local.
# Deja comentada (no vacía) una variable que no uses: "VAR=" vacía anula el default.

# Clave HMAC de la demo de consola aegis_core.py (firma y verificación del token).
# AEGIS_SECRET_KEY=

# Clave HMAC por defecto de mandate/sign.py (se usa cuando sign_payload no recibe
# una clave Ed25519 ni una clave explícita).
# AEGIS_HMAC_SECRET=

# Orígenes permitidos por CORS en api/main.py, separados por comas.
# Por defecto (dev): http://127.0.0.1:8000,http://localhost:5173
# CORS_ALLOWED_ORIGINS=

# ── Autenticación por email (api/auth.py) ────────────────────────────────────
# Cuenta SMTP (Gmail) que envía los códigos de verificación. Sin ella, fuera del
# modo desarrollo /auth/email/start responde 503 y no emite ningún código usable.
# SMTP_USER=
# SMTP_PASS=

# SOLO DESARROLLO LOCAL. Con AUTH_DEV_MODE=true (exactamente "true") la respuesta
# de /auth/email/start incluye el código en "code_demo" y se acepta aunque no haya
# SMTP. Con cualquier otro valor, o sin la variable, el código NUNCA se devuelve,
# ni siquiera si el envío del correo falla. NUNCA activarlo en producción.
# AUTH_DEV_MODE=true

# Política del código OTP (enteros positivos; los valores indicados son los defaults).
# AUTH_OTP_TTL_SECONDS=600               # validez del código (10 min)
# AUTH_OTP_MAX_ATTEMPTS=5                # intentos fallidos antes de invalidarlo
# AUTH_OTP_RESEND_COOLDOWN_SECONDS=60    # espera mínima entre pedidos al mismo email
# AUTH_OTP_MAX_SENDS_PER_HOUR=5          # pedidos máximos por email en una hora

# ── Access tokens (JWT HS256, core/auth_tokens.py) ───────────────────────────
# Clave con la que se firman y validan los tokens que emite /auth/email/check.
# OBLIGATORIA en producción: sin ella se usa una clave de DESARROLLO que está en el
# repositorio (cualquiera podría falsificar tokens). Usa al menos 32 bytes aleatorios,
# p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Vida del access token en segundos (entero positivo). Default: 3600 (60 min).
# JWT_TTL_SECONDS=3600
