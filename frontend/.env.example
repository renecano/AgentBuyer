# Copia este archivo a frontend/.env.local y ajusta los valores. No lo commitees.
# Vite solo expone al navegador las variables que empiezan con VITE_, y quedan
# incrustadas en el bundle: NUNCA pongas secretos aquí.

# URL base del backend (FastAPI), sin barra final.
# Default si no se define: http://127.0.0.1:8000
# VITE_API_BASE=http://127.0.0.1:8000
